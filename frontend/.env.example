# Copy to frontend/.env.local (git-ignored) and edit. Next.js loads .env.local itself.
# Nothing here is required: without this file the defaults below are used.

# Backend base URL, read on the server only. Both next.config.ts (rewrites /api/*, so
# the browser never needs CORS) and src/proxy.ts (session check before redirects) use it.
# Keep http://localhost:8080 when the backend runs on the host or is published on 8080;
# use the compose service name (http://backend:8080) when the frontend is a container too.
BACKEND_URL=http://localhost:8080

# Leave this unset to keep API calls on the frontend's own origin and let next.config.ts
# proxy them, which keeps cookies first-party. Set it only to have the browser call the
# backend directly; then it must be a full origin, and the backend's CORS_ORIGINS has to
# allow the frontend's origin (see backend/.env.example) because cookies cross origins.
# NEXT_PUBLIC_API_URL=http://localhost:8080/api