# Copy this file to backend/.env and fill it in. backend/.env is git-ignored.
# Plain KEY=value lines only; don't put comments on the same line as a value.

# The login account. Reset codes are emailed here, so use a real inbox you can read.
APP_AUTH_EMAIL=you@yourdomain.com
# Only used the first time the account is created. Change it later in Settings.
APP_AUTH_PASSWORD=changeme123

# Redis (stores login sessions). Must match the password docker compose starts Redis with.
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=todo

# Brevo SMTP: https://app.brevo.com > SMTP & API > SMTP tab
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# The "Login" shown on that tab, e.g. 8a1b2c001@smtp-brevo.com
MAIL_USERNAME=your-brevo-smtp-login
# An SMTP key generated on that tab (starts with xsmtpsib-), not your Brevo password
MAIL_PASSWORD=your-brevo-smtp-key
# Must be a sender you verified in Brevo (Senders, domains & dedicated IPs)
MAIL_FROM=tasks@yourdomain.com
MAIL_FROM_NAME=Tasks
